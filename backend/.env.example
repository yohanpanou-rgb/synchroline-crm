# Mongo
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=medi360

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# SMTP — used by app/services/email_service.py for every outgoing attachment email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=reports@medi360.gr
SMTP_FROM_NAME=medi360
SMTP_USE_TLS=true

# Weekly report automation (Render Cron Job -> POST /api/reports/send)
REPORTS_CRON_SECRET=change-me-to-a-long-random-string
WEEKLY_REPORT_RECIPIENTS=owner@medi360.gr

# CORS
FRONTEND_ORIGIN=http://localhost:5173
